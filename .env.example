# API Settings
API_V1_STR=/api/v1
PROJECT_NAME="SQL Optimization AI Agent"

# Security
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI Settings
OPENAI_API_KEY=your-openai-api-key

# GitHub Settings (Optional)
GITHUB_TOKEN=your-github-token

# Database Settings
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sql_optimizer
DB_MIN_SIZE=2
DB_MAX_SIZE=10
DB_FORCE_ROLLBACK=false
DB_SSL=false

# Logging
LOG_LEVEL=INFO

# Optimizer Settings
ACTIVE_OPTIMIZER=default
